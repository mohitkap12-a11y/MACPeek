<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>MacPeek</string>
    <key>CFBundleDisplayName</key><string>MacPeek</string>
    <key>CFBundleIdentifier</key><string>app.macpeek.MacPeek</string>
    <key>CFBundleExecutable</key><string>MacPeek</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUNDLE_VERSION__</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>LSUIElement</key><true/>
    <!-- Sparkle in-app updates. The public key is substituted by scripts/build-app.sh (SPARKLE_PUBLIC_ED_KEY);
         without a real key the app runs with updates switched off. -->
    <key>SUFeedURL</key><string>https://github.com/mohitkap12-a11y/MACPeek/releases/latest/download/appcast.xml</string>
    <!-- Preview (beta) feed, read instead of SUFeedURL only by Macs opted in with `receivePreviewBuilds`
         (docs/release.md, "Preview builds"). A fixed pre-release, so it is never "latest". -->
    <key>MacPeekPreviewFeedURL</key><string>https://github.com/mohitkap12-a11y/MACPeek/releases/download/preview-feed/appcast-beta.xml</string>
    <key>SUPublicEDKey</key><string>__SPARKLE_PUBLIC_ED_KEY__</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
    <!-- Remote management (off by default): shown by macOS the first time it is turned on. -->
    <key>NSLocalNetworkUsageDescription</key><string>MacPeek uses your local network only when you turn on Remote management, so MacPeek Remote consoles you pair with can find and connect to this Mac.</string>
    <key>NSBonjourServices</key><array><string>_macpeek._tcp</string></array>
    <!-- The MacPeek Remote service for "Add to my account" and the relay: substituted by scripts/build-app.sh
         (MACPEEK_ENV=staging or MACPEEK_API_URL; production by default). -->
    <key>MacPeekAPIURL</key><string>__API_URL__</string>
    <key>NSHumanReadableCopyright</key><string>MIT License. Open source.</string>
</dict>
</plist>
