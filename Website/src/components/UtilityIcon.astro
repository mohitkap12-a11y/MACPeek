---
import type { Utility } from '../data/utilities';
interface Props { utility: Pick<Utility, 'icon'>; size?: number }
const { utility, size = 22 } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={utility.icon} />
