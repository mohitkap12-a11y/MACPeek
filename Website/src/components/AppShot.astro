---
// Shows a REAL screenshot when one exists at public/screenshots/<name>.png, otherwise the data-driven
// illustration. To publish real captures: take them on a Mac (⌘⇧4, then Space, click the popover) and
// save them as Website/public/screenshots/<utility-id>.png (and launcher.png). No code change needed.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import UtilityPreview from './UtilityPreview.astro';
import type { Preview } from '../data/utilities';

interface Props { name: string; alt: string; preview: Preview }
const { name, alt, preview } = Astro.props;
const path = join(process.cwd(), 'public', 'screenshots', `${name}.png`);
const real = existsSync(path);
let dims: { w: number; h: number } | undefined;
if (real) {
  const buf = readFileSync(path);
  dims = { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) }; // PNG IHDR
}
---
{real
  ? <img class="shot" src={`/screenshots/${name}.png`} alt={alt} width={dims!.w} height={dims!.h} loading="lazy" decoding="async" />
  : <UtilityPreview preview={preview} />}
