---
import Base from './Base.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { SITE, docsNav, blogNav, blogPosts } from '../site';
import { byId } from '../data/utilities';

const { frontmatter } = Astro.props;
const { title, description, section = 'blog', h1, date = '2026-10-06', utility: utilityId } = frontmatter;
const util = utilityId ? byId(utilityId) : undefined;
const isDocs = section === 'docs';
const url = new URL(Astro.url.pathname, Astro.site).toString();
const home = new URL('/', Astro.site).toString();
const sectionUrl = new URL(isDocs ? '/docs/' : '/blog/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': isDocs ? 'TechArticle' : 'Article',
    headline: h1 ?? title,
    description,
    datePublished: date,
    dateModified: date,
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'MacPeek contributors' },
    publisher: { '@type': 'Organization', name: 'MacPeek', url: home },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: isDocs ? 'Docs' : 'Guides', item: sectionUrl },
      { '@type': 'ListItem', position: 3, name: h1 ?? title, item: url },
    ],
  },
];
const nav = isDocs ? docsNav : blogNav;
const sameUtility = blogPosts.filter((p) => p.utility === utilityId).map((p) => ({ href: `/blog/${p.slug}/`, label: p.label }));
const related = (isDocs ? blogNav : [...sameUtility, ...(util ? [{ href: `/utilities/${util.id}/`, label: `About ${util.name}` }] : []), ...docsNav.slice(0, 3)])
  .filter((l, i, a) => l.href !== Astro.url.pathname && a.findIndex((x) => x.href === l.href) === i)
  .slice(0, 5);
---
<Base title={title} description={description} jsonLd={jsonLd} ogType="article">
  <div class="wrap docs-layout">
    <aside class="docs-nav" aria-label={isDocs ? 'Documentation' : 'Guides'}>
      {nav.map((l) => <a href={l.href} aria-current={l.href === Astro.url.pathname ? 'page' : undefined}>{l.label}</a>)}
    </aside>
    <article class="article">
      <div class="crumbs"><a href="/">Home</a> › <a href={isDocs ? '/docs/' : '/blog/'}>{isDocs ? 'Docs' : 'Guides'}</a></div>
      <h1>{h1 ?? title}</h1>
      <slot />
      {!isDocs && util && (
        <div class="callout">
          {util.status === 'available' ? (
            <>
              <p><strong>{util.name} gives you the same visibility from your Mac menu bar.</strong> {util.tagline} It is a free, open-source utility inside MacPeek.</p>
              <DownloadCTA />
            </>
          ) : (
            <>
              <p><strong>{util.name} is coming to MacPeek.</strong> {util.tagline} It is not available yet; follow the project on GitHub to know when it ships.</p>
              <div class="cta" style="justify-content:flex-start">
                <a class="btn primary" href={`/utilities/${util.id}/`}>About {util.name}</a>
                <a class="btn" href={SITE.github}>Follow on GitHub</a>
              </div>
            </>
          )}
        </div>
      )}
      <nav class="related" aria-label="Related">
        <h2>Related</h2>
        <ul>{related.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </article>
  </div>
</Base>
