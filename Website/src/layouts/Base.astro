---
import '../styles/global.css';
import { SITE, downloadHref } from '../site';
import { utilities } from '../data/utilities';

interface Props { title: string; description: string; jsonLd?: object | object[]; ogType?: string; noindex?: boolean; }
const { title, description, jsonLd, ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const image = new URL('/og-image.png', Astro.site).toString();
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Preview deployments must never be indexed (Vercel also sends X-Robots-Tag for them; this is belt and braces).
const isPreview = process.env.VERCEL_ENV === 'preview';
const robots = noindex || isPreview ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
// Search Console / Bing Webmaster ownership tokens: set GOOGLE_SITE_VERIFICATION / BING_SITE_VERIFICATION in the build env.
const googleVerify = process.env.GOOGLE_SITE_VERIFICATION;
const bingVerify = process.env.BING_SITE_VERIFICATION;
const imageAlt = 'MacPeek: the tiny utilities macOS should have built in';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
    {bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#07080b" />
    <!-- Dark by default; runs before paint so a saved "light" choice never flashes dark. -->
    <script is:inline>
      (function () {
        var t = 'dark';
        try { var s = localStorage.getItem('portpeek-theme'); if (s === 'light' || s === 'dark') t = s; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.classList.add('js');
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="MacPeek guides" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <div class="bar">
          <a class="brand" href="/" aria-label="MacPeek home"><img src="/favicon.svg" width="26" height="26" alt="" /><span class="brand-text">MacPeek</span></a>
          <nav class="main" aria-label="Primary">
            <a class="link" href="/utilities/">Utilities</a>
            <a class="link" href="/docs/">Docs</a>
            <a class="link" href="/blog/">Guides</a>
            <a class="link" href={SITE.github}>GitHub</a>
            <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch to light mode" title="Switch theme">
              <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            <a class="btn primary small nav-cta" href={downloadHref}>Download</a>
            <button id="menu-toggle" class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
              <svg class="open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
              <svg class="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </nav>
        </div>
        <div id="mobile-menu" class="mobile-menu" hidden>
          <a href="/utilities/">Utilities</a>
          <a href="/docs/">Docs</a>
          <a href="/blog/">Guides</a>
          <a href={SITE.github}>GitHub</a>
          <a class="btn primary" href={downloadHref}>Download</a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site">
      <div class="wrap cols">
        <div>
          <strong>MacPeek</strong><br />Free &amp; open source (MIT). No account. No telemetry.<br />
          Not affiliated with Apple. macOS is a trademark of Apple Inc.
        </div>
        <div>
          <a href="/utilities/">Utilities</a><br /><a href="/docs/">Documentation</a><br /><a href="/blog/">Guides</a><br /><a href="/download/">Download</a>
        </div>
        <div>
          {utilities.filter((u) => u.status === 'available').map((u) => <Fragment><a href={`/utilities/${u.id}/`}>{u.name}</a><br /></Fragment>)}
        </div>
        <div>
          <a href={SITE.github}>GitHub</a><br />{SITE.hasRelease && <Fragment><a href={SITE.releases}>Releases</a><br /></Fragment>}<a href="/privacy/">Privacy</a><br /><a href="/security/">Security</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute('data-theme') !== 'light';
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          btn.setAttribute('aria-pressed', dark ? 'false' : 'true');
        }
        btn.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('portpeek-theme', next); } catch (e) {}
          sync();
        });
        sync();
      })();
      (function () {
        var btn = document.getElementById('menu-toggle'), menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        function set(open) {
          menu.hidden = !open;
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.documentElement.classList.toggle('menu-open', open);
        }
        btn.addEventListener('click', function () { set(menu.hidden); });
        menu.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
        window.matchMedia('(min-width: 761px)').addEventListener('change', function (m) { if (m.matches) set(false); });
      })();
    </script>
  </body>
</html>
