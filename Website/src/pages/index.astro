---
import Base from '../layouts/Base.astro';
import LauncherMock from '../components/LauncherMock.astro';
import AppShot from '../components/AppShot.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import UtilityIcon from '../components/UtilityIcon.astro';
import { SITE, liveTag, liveTagLong, liveSentence } from '../site';
import { utilities, byId, available, comingSoon } from '../data/utilities';

const title = 'MacPeek: The Tiny Utilities macOS Should Have Built In';
const portpeek = byId('portpeek')!;
const everyday = utilities.filter((u) => u.category === 'everyday');
const developer = utilities.filter((u) => u.category === 'developer');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'MacPeek',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'macOS 13 or later',
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    codeRepository: SITE.github,
    license: 'https://opensource.org/licenses/MIT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      ['What is MacPeek?', 'MacPeek is an open-source collection of small native macOS menu-bar utilities, called Peeks, for inspecting things macOS makes hard to see, such as which process is using a port.'],
      ['Which utilities are available today?', `${available.map((u) => u.name).join(', ')} is built into the app today${SITE.hasRelease ? '' : ' (the first signed release is not published yet)'}. ${comingSoon.length} more are in development: ${comingSoon.map((u) => u.name).join(', ')}.`],
      ['Does MacPeek send my data anywhere?', 'No. MacPeek has no account, no telemetry and makes no network connections. Information about your Mac stays on your Mac.'],
      ['Is MacPeek free?', 'Yes. MacPeek is free and open source under the MIT license.'],
    ].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <div class="pill"><i></i> Free &amp; open source · macOS 13+</div>
      <h1>The tiny utilities<br /><span class="grad">macOS should have built in.</span></h1>
      <p class="lead">One small menu-bar app with a growing set of focused utilities for finding, inspecting and understanding the things macOS makes hard to see. <strong>{liveSentence}</strong></p>
      <DownloadCTA />
      <p class="fine">No account · No telemetry · No cloud · Apple silicon &amp; Intel</p>
      <LauncherMock />
    </div>
  </section>

  <section class="block" id="utilities">
    <div class="wrap">
      <div class="eyebrow">Utilities</div>
      <h2>Small tools. One question each.</h2>
      <p class="sub">Switch on the Peeks you want and switch off the rest. A utility that is off does no work at all.</p>
      <div class="ugrid">
        {everyday.map((u) => (
          <a class="ucard" href={`/utilities/${u.id}/`}>
            <span class="uicon"><UtilityIcon utility={u} /></span>
            <h3>{u.name} <span class:list={['tag', { live: u.status === 'available' }]}>{u.status === 'available' ? liveTag : 'Coming soon'}</span></h3>
            <p>{u.tagline}</p>
          </a>
        ))}
      </div>
      <h3 class="group-title">Developer</h3>
      <div class="ugrid">
        {developer.map((u) => (
          <a class="ucard" href={`/utilities/${u.id}/`}>
            <span class="uicon"><UtilityIcon utility={u} /></span>
            <h3>{u.name} <span class="tag">Coming soon</span></h3>
            <p>{u.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt" id="portpeek">
    <div class="wrap split">
      <div>
        <div class="eyebrow">{liveTagLong}</div>
        <h2>PortPeek: see what's using your ports. Kill it in one click.</h2>
        <p class="sub" style="margin-bottom:12px">{portpeek.solution}</p>
        <ul class="checks">
          {portpeek.features.slice(0, 4).map((f) => <li>{f}</li>)}
        </ul>
        <a class="btn" href="/utilities/portpeek/">About PortPeek</a>
      </div>
      <div class="visual">
        <AppShot name="portpeek" alt="PortPeek listing listening ports with the node process on port 3000 expanded and a Kill Process button" preview={portpeek.preview} />
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap center">
      <div class="eyebrow">How it works</div>
      <h2>Install once. Peek at anything.</h2>
      <div class="steps4" style="text-align:left;margin-top:36px">
        <div class="card step"><h3>Install MacPeek</h3><p>Drag it to Applications. It lives in the menu bar: no Dock icon, no window.</p></div>
        <div class="card step"><h3>Choose your utilities</h3><p>Open <strong>Manage utilities</strong> to read what each Peek does, what it reads and what access it needs, then switch it on or off.</p></div>
        <div class="card step"><h3>Peek</h3><p>Click the icon, pick a utility or search for it, and get your answer in seconds.</p></div>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap center">
      <div class="eyebrow">Built in the open</div>
      <h2>Private by design.</h2>
      <p class="sub">MacPeek reads information from your Mac to show it to you, and never sends it anywhere. <a href="/privacy/">See exactly what each utility reads</a>.</p>
      <div class="privacy-list"><div>No account</div><div>No telemetry</div><div>No cloud required</div><div>Open source (MIT)</div></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap center">
      <div class="eyebrow">For developers and power users</div>
      <h2>Find → Inspect → Kill.</h2>
      <p class="sub">Dev servers, databases, caches, containers: PortPeek finds whatever grabbed the port. File locks, processes, disk activity, environment variables and DNS follow.</p>
      <div class="ports"><code>3000</code><code>5173</code><code>5432</code><code>6379</code><code>8080</code></div>
      <p>Prefer Terminal? We wrote the guides too: <a href="/blog/how-to-find-what-is-using-a-port-on-mac/">find what is using a port on Mac</a> and <a href="/blog/how-to-free-port-3000-on-mac/">free port 3000</a>.</p>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="panel">
        <h2>Download MacPeek</h2>
        <p class="sub" style="margin-inline:auto">Free and open source. Drag MacPeek to Applications and launch it; it appears in your menu bar.</p>
        <DownloadCTA />
        <p class="fine"><a href={SITE.github}>View source on GitHub</a> · <a href="/docs/installation/">Installation guide</a></p>
      </div>
    </div>
  </section>
</Base>
