---
import Base from '../layouts/Base.astro';
import AppMock from '../components/AppMock.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { SITE } from '../site';

const title = 'PortPeek — Find and Kill the Process Using a Port on Mac';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'PortPeek',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 13 or later',
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    downloadUrl: SITE.releases,
    codeRepository: SITE.github,
    license: 'https://opensource.org/licenses/MIT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      ['How do I find what is using a port on Mac?', 'Run lsof -nP -iTCP:3000 -sTCP:LISTEN in Terminal, or open PortPeek from the menu bar and search for the port number.'],
      ['Does PortPeek send my data anywhere?', 'No. PortPeek has no account, no telemetry and makes no network connections. Port and process information never leaves your Mac.'],
      ['Is PortPeek free?', 'Yes. PortPeek is free and open source under the MIT license.'],
    ].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <div class="pill"><i></i> Free &amp; open source · macOS 13+</div>
      <h1>See what's using your ports.<br /><span class="grad">Kill it in one click.</span></h1>
      <p class="lead">A lightweight native macOS menu bar app for finding and freeing network ports — no Terminal required.</p>
      <DownloadCTA />
      <p class="fine">No account · No telemetry · Apple silicon &amp; Intel</p>
      <AppMock />
    </div>
  </section>

  <section class="block" id="features">
    <div class="wrap">
      <div class="eyebrow">Why PortPeek</div>
      <h2>Your port is busy.<br />PortPeek tells you why.</h2>
      <p class="sub">Everything you need to find a process behind a port and free it. Nothing you don't.</p>
      <div class="bento">
        <div class="card span4"><div class="ico">🔎</div><h3>Find ports instantly</h3><p>Listening TCP and UDP ports visible to your user account, IPv4 and IPv6. Search by port, process name, PID or address — results update as you type.</p></div>
        <div class="card span2"><div class="ico">⚡</div><h3>One-click kill</h3><p>Free a port without opening Terminal.</p></div>
        <div class="card span2"><div class="ico">🛡️</div><h3>Safe by design</h3><p>Graceful SIGTERM first. The process is re-checked right before it's signalled, so a reused PID is never killed by mistake.</p></div>
        <div class="card span2"><div class="ico">⌘</div><h3>Native Mac app</h3><p>Swift and SwiftUI. Polls only while open — light on CPU and memory.</p></div>
        <div class="card span2"><div class="ico">🔓</div><h3>Open source</h3><p>MIT licensed. Read the code, build it, contribute.</p></div>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap center">
      <div class="eyebrow">Built for developers</div>
      <h2>Find → Inspect → Kill</h2>
      <p class="sub">Dev servers, databases, caches, containers — whatever grabbed the port.</p>
      <div class="ports"><code>3000</code><code>5173</code><code>5432</code><code>6379</code><code>8080</code></div>
      <div class="steps" style="text-align:left">
        <div class="card step"><h3>Find</h3><p>Click the menu bar icon and type a port, process or PID.</p></div>
        <div class="card step"><h3>Inspect</h3><p>See the process, PID, address, state and whether you're allowed to stop it.</p></div>
        <div class="card step"><h3>Kill</h3><p>Confirm once. PortPeek verifies the process exited and the port is free.</p></div>
      </div>
      <p style="margin-top:28px">Prefer Terminal? We wrote the guides too: <a href="/blog/how-to-find-what-is-using-a-port-on-mac/">find what is using a port on Mac</a> and <a href="/blog/how-to-free-port-3000-on-mac/">free port 3000</a>.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap center">
      <div class="eyebrow">Privacy first</div>
      <h2>Your Mac's business stays on your Mac.</h2>
      <p class="sub">PortPeek reads local process and socket information to draw the list, and never transmits it. <a href="/docs/privacy/">See exactly what it reads</a>.</p>
      <div class="privacy-list"><div>No account</div><div>No telemetry</div><div>No cloud</div><div>No network access</div></div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="panel">
        <h2>Download PortPeek</h2>
        <p class="sub" style="margin-inline:auto">Download the DMG, drag PortPeek to Applications, launch. It appears in your menu bar.</p>
        <DownloadCTA />
        <p class="fine"><a href={SITE.github}>View source on GitHub</a> · <a href="/docs/installation/">Installation guide</a></p>
      </div>
    </div>
  </section>
</Base>
