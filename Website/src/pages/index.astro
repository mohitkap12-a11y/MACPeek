---
import Base from '../layouts/Base.astro';
import AppMock from '../components/AppMock.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { SITE } from '../site';

const title = 'PortPeek — Find and Kill the Process Using a Port on Mac';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'PortPeek',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 13 or later',
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    downloadUrl: SITE.releases,
    codeRepository: SITE.github,
    license: 'https://opensource.org/licenses/MIT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      ['How do I find what is using a port on Mac?', 'Run lsof -nP -iTCP:3000 -sTCP:LISTEN in Terminal, or open PortPeek from the menu bar and search for the port number.'],
      ['Does PortPeek send my data anywhere?', 'No. PortPeek has no account, no telemetry and makes no network connections. Port and process information never leaves your Mac.'],
      ['Is PortPeek free?', 'Yes. PortPeek is free and open source under the MIT license.'],
    ].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <h1>See what's using your ports.<br /><span>Kill it in one click.</span></h1>
      <p class="lead">A lightweight native macOS menu bar app for finding and freeing network ports — no Terminal required.</p>
      <DownloadCTA />
      <p class="fine">Free · Open source · macOS 13+ · No account, no telemetry</p>
      <AppMock />
    </div>
  </section>

  <section class="block" id="features">
    <div class="wrap">
      <h2>Why PortPeek?</h2>
      <p class="sub">Your port is busy. PortPeek tells you why and lets you free it.</p>
      <div class="grid">
        <div class="card"><h3>Find ports instantly</h3><p>Search by port, process name, PID or address. Results update as you type.</p></div>
        <div class="card"><h3>Kill the process</h3><p>Free a port without opening Terminal. Graceful SIGTERM first; force-kill only when you say so.</p></div>
        <div class="card"><h3>Safe by design</h3><p>PortPeek re-checks the process just before it signals, so a reused PID is never killed by mistake.</p></div>
        <div class="card"><h3>Native Mac app</h3><p>Swift and SwiftUI. Lives in the menu bar, polls only while open, light on CPU and memory.</p></div>
        <div class="card"><h3>Open source</h3><p>MIT licensed. Read the code, build it yourself, contribute.</p></div>
        <div class="card"><h3>Private by default</h3><p>No account. No telemetry. No cloud. Your process information stays on your Mac.</p></div>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <h2>Built for developers</h2>
      <p class="sub">Dev servers, databases, caches, containers — whatever grabbed the port.</p>
      <div class="ports"><code>3000</code><code>5173</code><code>5432</code><code>6379</code><code>8080</code></div>
      <p class="flow">Find → Inspect → Kill</p>
      <p>Prefer Terminal? We wrote the guides too: <a href="/blog/how-to-find-what-is-using-a-port-on-mac/">find what is using a port on Mac</a> and <a href="/blog/how-to-free-port-3000-on-mac/">free port 3000</a>.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap narrow">
      <h2>Privacy first</h2>
      <p>No account. No telemetry. No cloud. PortPeek reads local process and socket information to show you the list, and never transmits it. <a href="/docs/privacy/">Read exactly what it reads</a>.</p>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap" style="text-align:center">
      <h2>Download PortPeek</h2>
      <p class="sub" style="margin-inline:auto">Download the DMG, drag PortPeek to Applications, launch. It appears in your menu bar.</p>
      <DownloadCTA />
      <p class="fine"><a href={SITE.github}>View source on GitHub</a> · <a href="/docs/installation/">Installation guide</a></p>
    </div>
  </section>
</Base>
