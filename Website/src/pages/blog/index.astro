---
import Base from '../../layouts/Base.astro';
import { blogPosts } from '../../site';
import { byId } from '../../data/utilities';
const groups = [...new Set(blogPosts.map((p) => p.utility))].map((id) => ({ util: byId(id)!, posts: blogPosts.filter((p) => p.utility === id) }));
---
<Base title="Mac Guides: Ports, Displays, USB, Sleep, Battery and Wi-Fi | MacPeek" description="Practical guides for Mac problems: find what is using a port, check monitor refresh rate, see USB devices, why a Mac will not sleep, battery health and Wi-Fi signal.">
  <div class="dx-landing">
    <section class="dx-hero">
      <div class="wrap">
        <div class="eyebrow">Guides</div>
        <h1>Mac guides</h1>
        <p class="dx-hero-sub">Short, practical answers for the things macOS makes hard to see.</p>
      </div>
    </section>
    <div class="wrap dx-landing-body">
      {groups.map((g) => (
        <section class="dx-section">
          <h2>{g.util.name}{g.util.status === 'available' ? '' : ' (coming soon)'}</h2>
          <div class="dx-cards">
            {g.posts.map((p) => (
              <a class="dx-card" href={`/blog/${p.slug}/`}>
                <h3>{p.label}<span aria-hidden="true">→</span></h3>
                <p>{g.util.question}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
